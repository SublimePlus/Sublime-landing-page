# Blog admin (/admin) — set these as secrets on the deployment, never in git.
#
# ADMIN_PASSWORD     The password for /admin. Required for the admin to work.
# ADMIN_SESSION_SECRET  Optional. Signs the session cookie. If unset, the
#                    password is used, which means changing the password signs
#                    every session out — usually what you want.
# GITHUB_TOKEN       Fine-grained personal access token, scoped to this
#                    repository only, with Contents: Read and write. This is
#                    what commits posts.
# GITHUB_REPO        owner/repo to commit to, e.g. SublimePlus/Sublime-landing-page
# GITHUB_BRANCH      Branch to commit to. Defaults to main.

ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_BRANCH=main
